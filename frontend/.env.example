# frontend/.env.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# TURN (Metered) — for reliable voice/video calls
VITE_TURN_USERNAME=your-metered-username
VITE_TURN_CREDENTIAL=your-metered-credential
VITE_METERED_API_KEY=your-metered-api-key
# Optional override:
# VITE_TURN_URL=turn:standard.relay.metered.ca:80
# VITE_METERED_TURN_API=https://your-app.metered.live/api/v1/turn/credentials?apiKey=...

# GIFs
VITE_GIPHY_API_KEY=your-giphy-api-key
