# backend/.env.example
# Purpose: Required environment variables for Spark backend
# Iteration: 1
# Copy to .env and fill in real values. Never commit .env.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (Project Settings → API → service_role)
# WARNING: Keep this secret. Never expose in frontend.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# PostgreSQL connection string (Project Settings → Database → Connection string → URI)
# Use the "Transaction" or "Session" pooler URL with asyncpg driver
# Format: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# JWT secret for signing access/refresh tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string

# Comma-separated list of allowed frontend origins (CORS)
# Include Vercel production URL and local dev
ALLOWED_ORIGINS=http://localhost:5173,https://spark-app.vercel.app

# Environment: development | production
ENVIRONMENT=development

# Optional: rate-limit storage (defaults to in-memory)
# REDIS_URL=
